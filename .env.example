# ============================================================================
#  漫簇 — 环境变量清单（模板）
#
#  重要：本程序**不会**自动读取 .env 文件。这个文件是配置项的说明书和抄写模板，
#  请把需要的行复制到「命令提示符」里用 set 设置，或在「系统属性 → 环境变量」
#  里永久设置，然后重新运行 start.ps1。
#
#  更简单的做法：启动程序后打开 http://127.0.0.1:8100/settings ，
#  在「供应商与 Key」页面里填，保存到 backend\config\providers.json。
#  环境变量的优先级高于配置文件，只适合临时覆盖。
#
#  所有形如 YOUR_..._HERE 的值都是占位符，必须换成你自己的真实值；
#  没有填的项就留空（或整行删掉），程序会使用默认值。
#
#  ⚠ 不要把填好真实 Key 的这份文件发给任何人。
# ============================================================================


# ---------------------------------------------------------------------------
#  1. 大模型（必填，除非用本地无鉴权端点如 Ollama）
# ---------------------------------------------------------------------------

# 供应商的 OpenAI 兼容地址，通常以 /v1 结尾。默认 https://api.deepseek.com/v1
STUDIO_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型 ID，必须是该供应商控制台里存在的名字。默认 deepseek-chat
STUDIO_LLM_MODEL=deepseek-chat

# 【必填】API Key。在供应商控制台 → API Keys 新建，只显示一次。
# 形如 sk-xxxxxxxxxxxxxxxx；占位值（如 sk-xxxx）会被程序识别为无效并提示。
STUDIO_LLM_API_KEY=YOUR_API_KEY_HERE

# 视觉模型（可选）。导演与质量审查需要读图；留空则回落到 STUDIO_LLM_MODEL。
STUDIO_LLM_VISION_MODEL=

# 单次请求超时（秒，默认 60）与采样温度（默认 0.4）
STUDIO_LLM_TIMEOUT=60
STUDIO_LLM_TEMPERATURE=0.4


# ---------------------------------------------------------------------------
#  2. 媒体生成（可选；不填就只产出提示词，不花钱）
# ---------------------------------------------------------------------------

# full  = 配置了生图/生视频模型就真的调用
# prompt = 只生成并校验提示词，永不调用生成接口（省钱、无需 GPU）
STUDIO_MEDIA_MODE=prompt

# 生图供应商名与模型（需与供应商侧一致）；留空表示该供应商不承担生图
STUDIO_IMAGE_PROVIDER=
STUDIO_IMAGE_MODEL=

# 生图使用的 Key 与地址。留空则复用上面的大模型配置（如果该供应商支持生图）
STUDIO_IMAGE_API_KEY=
STUDIO_IMAGE_BASE_URL=

# 可选的本地媒体生产后端（另装的 HTTP 服务，不是本程序的一部分）
MANCU_MEDIA_BASE_URL=http://127.0.0.1:3300
MANCU_MEDIA_TIMEOUT=180


# ---------------------------------------------------------------------------
#  3. 语义检索（不用填。默认用程序内置的本地向量模型）
# ---------------------------------------------------------------------------
#
# 知识库的语义召回默认由 backend/models/ 里的 bge-small-zh-v1.5（24 MB）在
# 进程内完成：不联网、不需要 key、不需要另装 Ollama。装完即可「上传一本书，
# 换个说法也能搜到」。
#
# 三种情况下才需要动这里：
#   · 想换模型/换目录 → STUDIO_EMBED_MODEL_DIR 指向一个含 model.onnx 与
#     tokenizer.json 的目录；
#   · 想要更高的向量质量（愿意付费）→ 填下面三行，指向任意 OpenAI 兼容的
#     /embeddings 端点（硅基流动 BAAI/bge-m3、阿里 text-embedding-v3、
#     智谱 embedding-3 都行）。三行缺一个就当没配。
#   · 完全不要语义检索（只留字面检索）→ 把模型目录移走即可，界面会明说
#     「未配置向量化模型」。
#
# STUDIO_EMBED_BASE_URL=
# STUDIO_EMBED_MODEL=
# STUDIO_EMBED_API_KEY=
# STUDIO_EMBED_MODEL_DIR=


# ---------------------------------------------------------------------------
#  3. 费用保护
# ---------------------------------------------------------------------------

# 单次运行的花费上限（美元）。超过即停止付费调用。默认 2.0
STUDIO_MAX_USD_PER_RUN=2.0


# ---------------------------------------------------------------------------
#  4. 目录位置（一般不用改；默认就是程序目录下的相对路径）
# ---------------------------------------------------------------------------

# 用户数据：数据库、上传素材、生成结果。默认 backend\userdata
STUDIO_DATA_DIR=

# 机器配置：providers.json 等。默认 backend\config
STUDIO_CONFIG_DIR=

# 数据库文件路径。默认 <STUDIO_DATA_DIR>\studio.db
STUDIO_DB_PATH=

# 供应商配置文件路径。默认 <STUDIO_CONFIG_DIR>\providers.json
STUDIO_PROVIDERS_PATH=


# ---------------------------------------------------------------------------
#  5. 飞书接入（可选，只在使用飞书文档时需要）
#     App ID / App Secret 在 https://open.feishu.cn 企业自建应用里获取；
#     重定向地址必须与应用后台登记的一致。
# ---------------------------------------------------------------------------

STUDIO_FEISHU_APP_ID=YOUR_APP_ID_HERE
STUDIO_FEISHU_APP_SECRET=YOUR_APP_SECRET_HERE
STUDIO_FEISHU_REDIRECT_URI=http://127.0.0.1:8100/api/mcp/feishu/callback
